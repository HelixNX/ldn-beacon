CONFIG_IDF_TARGET="esp32s3"
# the USB-Serial-JTAG port carries our protocol only: the console (and ESP-IDF's log) goes to UART0, and the log is
# also forwarded to the desktop as S3_LOG messages
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
# no block ack sessions of our own: a Switch needs none from a host (kinnay's sends plain data frames)
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# a panic saves a core dump to flash (partitions.csv): `idf.py -p <port> coredump-info` gives the backtrace (the panic
# text itself goes to UART0, which nobody reads)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
# the default event loop's task runs our Wi-Fi event handler, and ESP-IDF's log lines pass through log_vprintf (about
# 650 bytes of buffers): 2304 bytes overflowed (join run 6, 2026-11-07, core dump: stack overflow in sys_evt)
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
